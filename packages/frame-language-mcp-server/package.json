{
  "name": "@frame-language/mcp-server",
  "version": "0.1.0",
  "description": "MCP server exposing Frame Language precision discipline as AI tools",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "frame-language": "dist/index.js"
  },
  "main": "dist/index.js",
