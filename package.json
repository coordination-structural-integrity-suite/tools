{
  "name": "coordination-structural-integrity-suite-tools",
  "private": true,
  "version": "0.0.0",
  "description": "MCP server tooling for the Coordination Structural Integrity Suite (CSIS) and Frame Language substrate",
  "license": "Apache-2.0",
  "scripts": {
    "build": "pnpm -r build",
    "bundle": "node_modules/.bin/esbuild packages/csis-mcp-server/src/index.ts --bundle --platform=node --format=esm --outfile=csis-server.mjs && node_modules/.bin/esbuild packages/frame-language-mcp-server/src/index.ts --bundle --platform=node --format=esm --outfile=frame-language-server.mjs",
    "bundle:http": "node_modules/.bin/esbuild packages/csis-mcp-server/src/http.ts --bundle --platform=node --format=esm --outfile=csis-server-http.mjs && node_modules/.bin/esbuild packages/frame-language-mcp-server/src/http.ts --bundle --platform=node --format=esm --outfile=frame-language-server-http.mjs",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r --parallel exec rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "packageManager": "pnpm@11.1.3"
}
